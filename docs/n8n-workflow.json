{
  "name": "ciz01 – odeslání e-mailu z aplikace přes Outlook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ciz01-mailer",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "academy-webhook",
      "name": "Webhook z aplikace ciz01",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "e8d4a350-111c-4c8a-9ead-90a2255f9b20"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json.body;\nif (!input || typeof input.to !== 'string' || !/^[^\\s@<>,;]+@[^\\s@<>,;]+\\.[^\\s@<>,;]+$/.test(input.to) || input.to.length > 254) throw new Error('Invalid recipient');\nif (typeof input.subject !== 'string' || !input.subject.trim() || input.subject.length > 200 || /[\\r\\n]/.test(input.subject)) throw new Error('Invalid subject');\nif (typeof input.body !== 'string' || !input.body.trim() || input.body.length > 10000) throw new Error('Invalid body');\nif (typeof input.requestId !== 'string' || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(input.requestId)) throw new Error('Invalid request ID');\nreturn [{json: input}];"
      },
      "id": "academy-validate",
      "name": "Kontrola požadavku",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        230,
        0
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "toRecipients": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "bodyContent": "={{ $json.body }}",
        "additionalFields": {
          "bodyContentType": "Text"
        }
      },
      "id": "academy-send",
      "name": "Odeslat e-mail (Outlook)",
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2,
      "position": [
        460,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'sent', requestId: $('Webhook z aplikace ciz01').first().json.body.requestId } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "academy-response",
      "name": "Potvrdit odeslání aplikaci",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        690,
        0
      ]
    },
    {
      "parameters": {},
      "id": "academy-error-trigger",
      "name": "Při chybě workflow",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        260
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "toRecipients": "martin.cizkovsky@alza.cz",
        "subject": "=n8n: workflow {{ $json.workflow.name }} selhalo",
        "bodyContent": "=Workflow: {{ $json.workflow.name }}\nSpuštění: {{ $json.execution.id }}\nChyba: {{ $json.execution.error.message }}\n\nE-mail pravděpodobně nebyl odeslán. Před novým pokusem zkontrolujte záložku Executions.",
        "additionalFields": {
          "bodyContentType": "Text"
        }
      },
      "id": "academy-error-notify",
      "name": "Upozornit vlastníka na chybu",
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2,
      "position": [
        230,
        260
      ]
    }
  ],
  "connections": {
