{
  "name": "AI Academy Mailer — Header Auth",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-academy-mailer",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "academy-webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "e8d4a350-111c-4c8a-9ead-90a2255f9b20"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json.body;\nif (!input || typeof input.to !== 'string' || !/^[^\\s@<>]+@[^\\s@<>]+\\.[^\\s@<>]+$/.test(input.to) || input.to.length > 254) throw new Error('Invalid recipient');\nif (typeof input.subject !== 'string' || !input.subject.trim() || input.subject.length > 200 || /[\\r\\n]/.test(input.subject)) throw new Error('Invalid subject');\nif (typeof input.body !== 'string' || !input.body.trim() || input.body.length > 10000) throw new Error('Invalid body');\nif (typeof input.requestId !== 'string' || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(input.requestId)) throw new Error('Invalid request ID');\nreturn [{json: input}];"
      },
      "id": "academy-validate",
      "name": "Validate request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        230,
        0
      ]
    },
    {
      "parameters": {
        "fromEmail": "owner@example.com",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "academy-send",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        460,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'sent', requestId: $('Webhook').first().json.body.requestId } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "academy-response",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        690,
        0
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Validate request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate request": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveExecutionProgress": false,
    "saveManualExecutions": false
  },
  "active": false,
  "pinData": {}
}
